# ============================================================
#  remna-orchestrator configuration
#  Copy to `.env` and fill in the real values.
# ============================================================

# --- Service ---
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8080
# Bearer token clients MUST pass to our REST API. Change this!
API_TOKEN=change-me-to-a-long-random-string

# --- Database (SQLite by default; PostgreSQL also supported) ---
DATABASE_URL=sqlite+aiosqlite:///./data/remna-orchestrator.db

# --- Remnawave Panel ---
REMNAWAVE_BASE_URL=https://panel.example.com
REMNAWAVE_API_TOKEN=paste-token-from-remnawave-panel-settings

# --- Cloud provider ---
# one of: hetzner, h2nexus, none
CLOUD_PROVIDER=hetzner

# Hetzner Cloud
HETZNER_TOKEN=your-hetzner-cloud-api-token
HETZNER_DEFAULT_LOCATION=fsn1        # fsn1, nbg1, hel1, ash, hil, sin
HETZNER_DEFAULT_IMAGE=ubuntu-24.04
HETZNER_DEFAULT_SERVER_TYPE=cx22     # €3.79/mo: 2 vCPU, 4 GB RAM, 40 GB SSD
HETZNER_SSH_KEY_NAME=remna-orchestrator   # name of a pre-uploaded SSH key

# h2.nexus (only needed if CLOUD_PROVIDER=h2nexus)
H2NEXUS_BASE_URL=https://my.h2.nexus/billmgr
H2NEXUS_USERNAME=
H2NEXUS_PASSWORD=
H2NEXUS_VERIFY_SSL=true

# --- DNS provider ---
DNS_PROVIDER=cloudflare
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token-with-Zone.DNS-edit
CLOUDFLARE_ZONE_ID=your-zone-id
CLOUDFLARE_ROOT_DOMAIN=example.com
CLOUDFLARE_SUBSCRIPTION_HOST=sub

# --- Rotation triggers ---
ROTATION_SCHEDULE_ENABLED=true
ROTATION_SCHEDULE_CRON=0 */6 * * *   # every 6 hours
ROTATION_PROBE_ENABLED=true
ROTATION_PROBE_INTERVAL_SECONDS=300
ROTATION_MANUAL_ENABLED=true

# --- Probe ---
PROBE_FAILURE_THRESHOLD=3
PROBE_SUCCESS_THRESHOLD=2
PROBE_TIMEOUT_SECONDS=10

# --- Pool sizing ---
NODE_POOL_MIN_SIZE=2
NODE_POOL_MAX_SIZE=5
